# Домен разворачиваемого приложения. Единственное место, где он указан:
# docker-compose отдаёт его nginx как APP_DOMAIN, а backend берёт из APP_URL.
# Сменил здесь - сменилось везде.
COMPOSE_PROJECT_NAME=timing
APP_DOMAIN=timing.myftp.org

# PostgreSQL. В Docker DB_HOST переопределяется на timing_db в docker-compose.
DB_USER=user
DB_PASS=your-database-password   # обязательно, без пароля compose не стартует
DB_HOST=localhost
DB_PORT=5432
DB_NAME=timingdb
# DATABASE_URL перекрывает пять строк выше целиком.
# DATABASE_URL=postgresql://user:pw@localhost:5432/timingdb

# Первый администратор: создаётся при старте, если такого логина ещё нет.
ADMIN_EMAIL=admin@timing.local
ADMIN_PASSWORD=changeme          # обязательно, смени на сервере
ADMIN_FIRST_NAME=Admin
ADMIN_LAST_NAME=Timing

# Подпись JWT. SECRET_KEY — случайная строка >=32 символов, обязательно.
SECRET_KEY=your-secret-key-here
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=10080   # 7 дней

# Почта по умолчанию — локальный Mailpit (внешняя отправка выключена):
# Письма никуда не уходят. Смотреть: http://localhost:8025 или
# https://timing.website/mailpit/ (nginx, basic-auth: логин timing).
SMTP_HOST=mailpit
SMTP_PORT=1025
SMTP_USER=
SMTP_PASSWORD=
EMAIL_FROM=no-reply@timing.local
SMTP_STARTTLS=false
# Пароль панельки Mailpit на сайте (по умолчанию demo2024 — смени для продакшна).
MAILPIT_PANEL_PASSWORD=demo2024

# Яндекс SMTP (если нужна реальная отправка): нужен ПАРОЛЬ ПРИЛОЖЕНИЯ,
# не пароль от аккаунта: https://id.yandex.ru/security/apppasswords
# 587 = SMTP + STARTTLS. Порт 465 тоже работает (SMTP_SSL), но не нужен.
# EMAIL_FROM должен совпадать с SMTP_USER.
# SMTP_HOST=smtp.yandex.ru
# SMTP_PORT=587
# SMTP_USER=your@yandex.ru
# SMTP_PASSWORD=your-app-password
# EMAIL_FROM=your@yandex.ru

# Ollama: ИИ-ассистент. В Docker адрес — http://ollama:11434 (сервис compose).
OLLAMA_URL=http://ollama:11434
OLLAMA_MODEL=qwen2.5:7b
# Образ Ollama. По умолчанию — запечённый с GHCR (~9 ГБ: модель уже внутри,
# качать её не нужно). Вариант без модели — стоковый ollama/ollama:latest,
# тогда модель качает ollama-init при OLLAMA_AUTO_PULL=true (~4.7 ГБ с
# реестра Ollama) или вручную: docker exec timing_ollama ollama pull qwen2.5:7b
OLLAMA_IMAGE=ghcr.io/levgamer39/timing/ollama:latest
# true -> сервис ollama-init сам докачает модель при первом запуске, если её
# нет в образе (~4.7 ГБ, несколько минут). false -> ничего не качает.
OLLAMA_AUTO_PULL=true

# Часовой пояс по умолчанию. Браузер присылает свой, и он важнее: в БД время
# в UTC, а «завтра 18:00» значит 18:00 там, где сидит ученик.
TIMEZONE=Europe/Moscow

# Параметры модели. Ollama без num_ctx обрезает промпт до 2-4k токенов,
# поэтому значение задаётся явно. При переезде на мощное железо меняется
# только этот блок, код трогать не нужно.
AI_NUM_CTX=8192
AI_TIMEOUT=90
AI_TEMPERATURE=0.3
AI_NUM_PREDICT=700
AI_KEEP_ALIVE=-1   # -1 — не выгружать модель из памяти (ответы без ожидания загрузки)

# Сколько данных попадает в базовый контекст. Остальное модель добирает
# инструментами (все оценки по предмету, все задачи).
AI_CONTEXT_GRADES=3
AI_CONTEXT_TASKS=30
AI_CONTEXT_DAYS=7

# Бюджет истории чата в символах и её сжатие. Сжатие — один запрос к модели
# и только когда история в бюджет не влезает.
AI_HISTORY_CHARS=8000
AI_COMPACT_KEEP=20
AI_SUMMARY_CHARS=2000
AI_CHAT_TITLE_CHARS=60

# Дополнительные инструкции в system prompt, без релиза кода.
AI_PROMPT_EXTRA=

# Публичный адрес для ссылок в письмах. Для локальной разработки
# поставь http://localhost:8000, иначе ссылки в письмах уводят на прод.
APP_URL=https://timing.myftp.org
DEBUG=false   # true — только локально, на сервере всегда false

# Выключает фоновые джобы (тесты, одноразовые команды)
ENABLE_SCHEDULER=true

# День и час недельной сводки. Читают и бэкенд (письмо-копия), и бот (MAX):
# WEEKLY_SUMMARY_WEEKDAY — 0=понедельник .. 6=воскресенье, время в TIMEZONE.
WEEKLY_SUMMARY_WEEKDAY=6
WEEKLY_SUMMARY_HOUR=18

# OAuth Яндекса (вход + привязка в настройках). Без них кнопка входа через
# Яндекс отдаёт 503. Дашборд: https://oauth.yandex.ru/client
YANDEX_CLIENT_ID=your-yandex-client-id
YANDEX_CLIENT_SECRET=your-yandex-client-secret
# По умолчанию берутся из APP_URL - задавай, только если адрес другой.
# YANDEX_LOGIN_CALLBACK=https://timing.myftp.org/api/auth/yandex/callback
# YANDEX_LINK_CALLBACK=https://timing.myftp.org/api/auth/yandex/confirm-link

# === MAX Bot ===
# Обязателен только токен бота из MAX.
MAX_BOT_TOKEN=your_bot_token_here
# Публичное имя (username) бота: нужна для OPEN-кнопки мини-приложения
# (автовход на сайт из MAX). Мини-апп регистрируется на этого бота в кабинете MAX.
MAX_BOT_USERNAME=
MAX_BOT_URL=http://backend:8000   # адрес API бэкенда для бота
BOT_UPDATE_MODE=long_polling      # long_polling | webhook
WEBHOOK_URL=                     # только при BOT_UPDATE_MODE=webhook
WEBHOOK_SECRET=                  # только при BOT_UPDATE_MODE=webhook
PARSER_ENABLED=true              # парсер ДЗ в чатах класса
PARSER_BATCH_INTERVAL_MINUTES=15 # как часто разбирать сообщения чатов
PARSER_KEYWORD_FILTER=true       # фильтровать сообщения по словам-маркерам
# Распознавать голосовые в авто-парсере чатов класса. /hw и «Добавить»
# работают всегда.
PARSER_VOICE_ENABLED=true
# faster-whisper: модель скачивается при сборке образа бота.
# По умолчанию распознавание выключено: модель не скачивается при сборке
# (build-arg PRELOAD_WHISPER) и не грузится в память при старте.
# true — включить голосовые.
VOICE_ENABLED=false
WHISPER_MODEL=small        # размер модели Whisper (tiny/base/small/medium)
WHISPER_MODEL_DIR=models   # куда скачивается модель при сборке образа
WHISPER_DEVICE=cpu         # cpu | cuda
WHISPER_COMPUTE_TYPE=int8  # int8 | float16
WHISPER_LANGUAGE=ru        # язык распознавания
AUDIO_TEMP_DIR=data/tmp    # временные файлы голосовых
VOICE_DOWNLOAD_TIMEOUT=60  # секунд на скачивание аудио из MAX
REMINDERS_ENABLED=true     # напоминания о сроках в MAX
REMINDER_INTERVAL_MINUTES=30   # как часто проверять сроки
# Сводка в MAX. День и час (WEEKLY_SUMMARY_WEEKDAY/HOUR) — в блоке выше:
# их же читает бэкенд для почтовой копии.
WEEKLY_SUMMARY_ENABLED=true   # недельная сводка в MAX (день/час — выше)
BOT_STATE_PATH=data/bot_state.json   # runtime-состояние бота (volume)
LOG_LEVEL=INFO                # DEBUG при отладке
# Соль для HMAC-хеширования MAX user_id. Сгенерируйте случайную строку.
# Смена соли или ротация MAX_BOT_TOKEN инвалидирует все привязки MAX.
BOT_USER_ID_SALT=replace-with-random-64-char-string
