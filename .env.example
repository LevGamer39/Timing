# Домен разворачиваемого приложения. Единственное место, где он указан:
# docker-compose отдаёт его nginx как APP_DOMAIN, а backend берёт из APP_URL.
# Сменил здесь - сменилось везде.
APP_DOMAIN=vector.myftp.org

DB_USER=user
DB_PASS=your-database-password
DB_HOST=localhost
DB_PORT=5432
DB_NAME=vectordb
# DATABASE_URL перекрывает пять строк выше целиком.
# DATABASE_URL=postgresql://user:pw@localhost:5432/vectordb

ADMIN_EMAIL=admin@vector.local
ADMIN_PASSWORD=changeme
ADMIN_FIRST_NAME=Admin
ADMIN_LAST_NAME=Vector

SECRET_KEY=your-secret-key-here
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=10080

# Яндекс. Нужен ПАРОЛЬ ПРИЛОЖЕНИЯ, не пароль от аккаунта:
# https://id.yandex.ru/security/apppasswords
# 587 = SMTP + STARTTLS. Порт 465 тоже работает (SMTP_SSL), но не нужен.
# EMAIL_FROM должен совпадать с SMTP_USER.
SMTP_HOST=smtp.yandex.ru
SMTP_PORT=587
SMTP_USER=your@yandex.ru
SMTP_PASSWORD=your-app-password
EMAIL_FROM=your@yandex.ru

OLLAMA_URL=http://ollama:11434
OLLAMA_MODEL=qwen2.5:7b
# true -> сервис ollama-init сам докачает модель при первом запуске
# (~4.7 ГБ, несколько минут). false -> ничего не качает, модель ставится
# вручную: docker exec vector_ollama ollama pull qwen2.5:7b
OLLAMA_AUTO_PULL=false

# Часовой пояс по умолчанию. Браузер присылает свой, и он важнее: в БД время
# в UTC, а «завтра 18:00» значит 18:00 там, где сидит ученик.
TIMEZONE=Europe/Moscow

# Параметры модели. Ollama без num_ctx обрезает промпт до 2-4k токенов,
# поэтому значение задаётся явно. При переезде на мощное железо меняется
# только этот блок, код трогать не нужно.
AI_NUM_CTX=8192
AI_TIMEOUT=90
AI_TEMPERATURE=0.3
AI_NUM_PREDICT=700
AI_KEEP_ALIVE=30m

# Сколько данных попадает в базовый контекст. Остальное модель добирает
# инструментами (все оценки по предмету, все задачи).
AI_CONTEXT_GRADES=3
AI_CONTEXT_TASKS=30
AI_CONTEXT_DAYS=7

# Бюджет истории чата в символах и её сжатие. Сжатие — один запрос к модели
# и только когда история в бюджет не влезает.
AI_HISTORY_CHARS=8000
AI_COMPACT_KEEP=20
AI_SUMMARY_CHARS=2000
AI_CHAT_TITLE_CHARS=60

# Дополнительные инструкции в system prompt, без релиза кода.
AI_PROMPT_EXTRA=

# Публичный адрес для ссылок в письмах. Для локальной разработки
# поставь http://localhost:8000, иначе ссылки в письмах уводят на прод.
APP_URL=https://vector.myftp.org
DEBUG=false

# Выключает фоновые джобы (тесты, одноразовые команды)
ENABLE_SCHEDULER=true

YANDEX_CLIENT_ID=your-yandex-client-id
YANDEX_CLIENT_SECRET=your-yandex-client-secret
# По умолчанию берутся из APP_URL - задавай, только если адрес другой.
# YANDEX_LOGIN_CALLBACK=https://vector.myftp.org/api/auth/yandex/callback
# YANDEX_LINK_CALLBACK=https://vector.myftp.org/api/auth/yandex/confirm-link

# === MAX Bot ===
# Обязателен только токен бота из MAX.
MAX_BOT_TOKEN=your_bot_token_here
MAX_BOT_URL=http://backend:8000
BOT_UPDATE_MODE=long_polling
WEBHOOK_URL=
WEBHOOK_SECRET=
PARSER_ENABLED=true
PARSER_BATCH_INTERVAL_MINUTES=15
PARSER_KEYWORD_FILTER=true
# Распознавать голосовые в авто-парсере чатов класса. /hw и «Добавить»
# работают всегда.
PARSER_VOICE_ENABLED=true
# faster-whisper: модель скачивается при сборке образа бота.
WHISPER_MODEL=small
WHISPER_MODEL_DIR=models
WHISPER_DEVICE=cpu
WHISPER_COMPUTE_TYPE=int8
WHISPER_LANGUAGE=ru
AUDIO_TEMP_DIR=data/tmp
VOICE_DOWNLOAD_TIMEOUT=60
REMINDERS_ENABLED=true
REMINDER_INTERVAL_MINUTES=30
WEEKLY_SUMMARY_ENABLED=true
WEEKLY_SUMMARY_WEEKDAY=6
WEEKLY_SUMMARY_HOUR=18
BOT_STATE_PATH=data/bot_state.json
LOG_LEVEL=INFO
# Соль для HMAC-хеширования MAX user_id. Сгенерируйте случайную строку.
BOT_USER_ID_SALT=replace-with-random-64-char-string
